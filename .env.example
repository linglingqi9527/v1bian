VITE_APP_VERSION=0.1.0
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_PROVIDER=cloudbase
VITE_ANALYTICS_ENDPOINT=

# JudgeAgent LLM proxy
VITE_JUDGE_LLM_PROVIDER=api-proxy
VITE_JUDGE_AGENT_ENDPOINT=/api/judge-agent
VITE_JUDGE_MODEL_PROFILE=default
JUDGE_LLM_BASE_URL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=qwen-max
JUDGE_LLM_FAST_MODEL=qwen-turbo
JUDGE_LLM_TEMPERATURE=0.2

# JudgeAgent video transcript proxy
# The endpoint should accept { videoUrl, bvId, matchId, title, speakerGroups }
# and return { text } or plain transcript text.
JUDGE_TRANSCRIPT_PROVIDER=local
JUDGE_TRANSCRIPT_ENDPOINT=
JUDGE_TRANSCRIPT_API_KEY=
JUDGE_TRANSCRIPT_MOCK_TEXT=
JUDGE_TRANSCRIPT_MODEL=small
JUDGE_TRANSCRIPT_AUDIO_START=0
JUDGE_TRANSCRIPT_AUDIO_DURATION=4200
